# ============================================
# FRONTEND Environment Variables (VITE_*)
# ============================================
# These are exposed to the browser (safe for public use)

# Google Gemini AI (for frontend fallback - optional)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Tavus Video API Keys (for Expert Session)
VITE_TAVUS_API_KEY=your_tavus_api_key_here
VITE_TAVUS_REPLICA_ID=your_replica_id_here
VITE_TAVUS_PERSONA_ID=your_persona_id_here

# ============================================
# BACKEND Environment Variables (Netlify Functions)
# ============================================
# These are server-side only (NOT exposed to browser)
# Add these to Netlify Dashboard → Site Settings → Environment Variables

# Gemini AI API Key (for Netlify Function)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavus API Keys (for Netlify Function)
TAVUS_API_KEY=your_tavus_api_key_here
TAVUS_REPLICA_ID=your_replica_id_here
TAVUS_PERSONA_ID=your_persona_id_here